# Copy this file to .env, or let scripts/setup.sh write it for you.

# Where the database and the media files live (inside the container: /data)
DATA_DIR=./data
# Your admin link: https://<domain>/admin?key=<ADMIN_KEY>, use: openssl rand -hex 16
ADMIN_KEY=change-me
# Signs the cookie that identifies a guest, use: openssl rand -hex 32
COOKIE_SECRET=change-me
# Public address the QR code points to
PUBLIC_BASE_URL=http://localhost:5173
# Deployment only: domain for Caddy and its TLS certificate
DOMAIN=photos.example.com
ORIGIN=https://photos.example.com
# Optional fallback for the header. The setup wizard at /setup writes the real one.
EVENT_TITLE=
